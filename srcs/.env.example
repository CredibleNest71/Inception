# DOMAIN
DOMAIN_NAME=mresch.42.fr

# DATABASE
MYSQL_DATABASE=wordpress
MYSQL_USER=change_me
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

# WORDPRESS
WORDPRESS_DB_NAME=wordpress
WP_USER_NAME=change_me
WP_USER_PASSWORD=change_me
WP_USER_EMAIL=user@example.com
WORDPRESS_DB_HOST=mariadb

# WORDPRESS ADMIN
WP_ADMIN_USER=change_me
WP_ADMIN_PASSWORD=change_me
WP_ADMIN_EMAIL=admin@example.com
WP_TITLE="My Blog"

# VOLUMES
WORDPRESS_VOLUME=/home/mresch/data/wordpress
MARIADB_VOLUME=/home/mresch/data/mariadb

# SSL
NGINX_SSL_CRT_FILE=~/mresch/data/certs/nginx.crt
NGINX_SSL_KEY_FILE=~/mresch/data/certs/nginx.key
